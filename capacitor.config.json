{
  "appId": "com.grip.app",
  "appName": "Grip",
  "webDir": "build",
  "bundledWebRuntime": false,
  "plugins": {
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": false,
      "iosKeychainPrefix": "Grip",
      "iosBiometric": {
        "biometricAuth": false,
        "biometricTitle": "Biometric login for sqlite"
      },
      "androidIsEncryption": false,
      "androidBiometric": {
        "biometricAuth": false,
        "biometricTitle": "Biometric login for sqlite"
      }
    }
  }
}
